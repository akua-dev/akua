# Hand-written, not generated. `packages/sdk` is part of the grafted upstream
# akua-dev/akuapkg history (published source view; publishing-source-views
# skill) and sits outside `generate-workspace-verification`'s discovery roots
# (apps/, packages/, deploy/ only - see discoverCheckWorkspaces in
# packages/cli/src/commands/bazel/generate-workspace-verification.ts) and
# outside this repo's Effect/typecheck conventions (banned-imports and
# effect-adoption both already exempt tools/akuapkg/source/** as vendored
# external code; see ALWAYS_IGNORED_TARGETS in
# packages/cli/src/commands/check/banned-imports-core.ts). This file exists
# only so cnap consumers can resolve `@akua-dev/sdk` as a workspace:* npm
# link (akua-dev/cnap#2348) - it deliberately does not add the full
# workspace_verification_package typecheck/lint/format surface that package
# would carry for a first-party cnap package. Do not add Starlark here that
# references another cnap package by `//`-label (the projection boundary -
# this directory is Josh-projected to the public akua-dev/akuapkg repo);
# `@bun_imports`/`@bazel_lib`/`@aspect_rules_js` external-repo loads are
# fine, same as tools/cli/source's write_generated pattern this mirrors.
#
# package.json's exports carry a `types` condition pointing at dist/*.d.ts
# and a `default` condition pointing at dist/*.js - both are real,
# Bazel-built, drift-checked artifacts (no consumer ever resolves raw
# src/*.ts, so no consuming tsconfig anywhere in cnap needs
# allowImportingTsExtensions; akua-dev/cnap#2348). A Node.js consumer
# cannot type-strip a .ts file under node_modules (packages/domains/
# packages' isolated-render child process hits this under the vitest/
# Node test runner even though Bun does not), which is why dist/*.js is
# needed at all; dist/*.d.ts exists because emitted declarations
# otherwise preserve the SDK's own .ts-extension import style (a
# TypeScript emitter limitation for relative specifiers, not a resolver
# choice), which would just move the same TS5097 problem into every
# consumer's type-check. `sdk_mod_js` / `sdk_execute_js` (bun_bundle)
# and `sdk_declarations` (sdk_tsc_declarations, tools/akuapkg/
# sdk_declarations.bzl - a hermetic `tsc --emitDeclarationOnly`) build
# both from src/ independently; `sdk_dist` (copy_to_directory) merges
# them into one tree, and `sdk_dist_write_generated` (below) is the
# write_source_files target that keeps the committed dist/ honest -
# `sdk_dist_write_generated_test` (registered as the
# `akuapkg_sdk_dist_drift` CI gate in the root BUILD.bazel) fails if
# src/ and the committed dist/ disagree; `bazel run
# //tools/akuapkg/source/packages/sdk:sdk_dist_write_generated`
# refreshes it. This is deliberately narrower than the full npm-era
# build (no sourcemaps): those served npm-tarball consumers, and npm
# publishing is discontinued (akua-dev/cnap#2348).
_SDK_SRCS = glob(
    ["src/**", "dist/**", "package.json", "README.md"],
    exclude = ["node_modules/**"],
    allow_empty = True,
)

# Consumed by the generated `_workspace_package_src` fallback in
# tools/bun/generated/packages_imports.bzl: once a directory owns its own
# BUILD.bazel, a root-relative glob can no longer cross into it, so that
# generator aliases to `//<path>:package_src` instead.
filegroup(
    name = "package_src",
    srcs = _SDK_SRCS,
    visibility = ["//visibility:public"],
)

js_library(
    name = "workspace_verification_production_package_src",
    srcs = glob(
        ["src/**", "dist/**", "package.json", "README.md"],
        exclude = ["src/**/*.test.ts", "node_modules/**"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

# tools/akuapkg/BUILD.bazel's typescript_only_policy_srcs aggregates this
# target from every subpackage discovered under tools/akuapkg (via
# native.subpackages); this package became a subpackage the moment it got
# its own BUILD.bazel above, so it must expose the same target name.
filegroup(
    name = "typescript_only_policy_srcs",
    srcs = glob(["**/*.py"], allow_empty = True),
    visibility = ["//visibility:public"],
)

# --- Committed dist/*.js drift gate --------------------------------------
#
# Mirrors tools/cli's write_generated pattern (tools/cli/BUILD.bazel):
# build the artifact hermetically, then use write_source_files so
# `<name>_test` is a real CI-registerable diff test and `bazel run <name>`
# is the one blessed way to refresh the committed copy.

_link_ajv(link_name = "ajv")

_link_yaml(link_name = "yaml")

_link_typescript(
    dev = True,
    link_name = "typescript",
)

_link_akua_native(link_name = "@akua-dev/native")

_link_standard_schema(link_name = "@standard-schema/spec")

_link_types_node(
    dev = True,
    link_name = "@types/node",
)

_SDK_BUNDLE_SRCS = glob(
    ["src/**/*.ts", "src/**/*.json"],
    exclude = ["src/**/*.test.ts"],
)

_SDK_BUNDLE_EXTERNAL = [
    "@akua-dev/native",
    "@standard-schema/spec",
    "ajv",
    "yaml",
]

_SDK_BUNDLE_DEPS = [
    ":node_modules/@akua-dev/native",
    ":node_modules/@standard-schema/spec",
    ":node_modules/ajv",
    ":node_modules/yaml",
]

bun_bundle(
    name = "sdk_mod_js",
    srcs = _SDK_BUNDLE_SRCS,
    out = "mod.js",
    entry = "src/mod.ts",
    external = _SDK_BUNDLE_EXTERNAL,
    deps = _SDK_BUNDLE_DEPS,
)

bun_bundle(
    name = "sdk_execute_js",
    srcs = _SDK_BUNDLE_SRCS,
    out = "execute.js",
    entry = "src/execute.ts",
    external = _SDK_BUNDLE_EXTERNAL,
    deps = _SDK_BUNDLE_DEPS,
)

sdk_tsc_declarations(
    name = "sdk_declarations",
    srcs = _SDK_BUNDLE_SRCS,
    out_dir = "sdk_declarations_dir",
    tsconfig = "tsconfig.json",
    deps = _SDK_BUNDLE_DEPS + [
        ":node_modules/typescript",
        ":node_modules/@types/node",
    ],
)

copy_to_directory(
    name = "sdk_dist",
    srcs = [
        ":sdk_mod_js",
        ":sdk_execute_js",
        ":sdk_declarations",
    ],
    replace_prefixes = {
        "sdk_declarations_dir/": "",
    },
)

write_source_files(
    name = "sdk_dist_write_generated",
    files = {
        "dist": ":sdk_dist",
    },
    visibility = ["//visibility:public"],
)
