"""Sources of the akua-apply engine. Its build targets live in //bazel/cluster-agent."""

exports_files(
    [
        "go.mod",
        "go.sum",
    ],
    visibility = ["//visibility:public"],
)

[
    filegroup(
        name = name + "_srcs",
        srcs = glob(
            [path + "/*.go"],
            exclude = ["**/*_test.go"],
        ),
        visibility = ["//visibility:public"],
    )
    for name, path in [
        ("akua_apply", "cmd/akua-apply"),
        ("cache", "internal/cache"),
        ("live", "internal/live"),
        ("ops", "internal/ops"),
        ("protocol", "internal/protocol"),
        ("serve", "internal/serve"),
    ]
]

[
    filegroup(
        name = name + "_test_srcs",
        srcs = glob([path + "/*_test.go"]),
        visibility = ["//visibility:public"],
    )
    for name, path in [
        ("cache", "internal/cache"),
        ("live", "internal/live"),
        ("ops", "internal/ops"),
        ("protocol", "internal/protocol"),
        ("serve", "internal/serve"),
    ]
]

filegroup(
    name = "fixture_test_srcs",
    srcs = [
        "golden_test.go",
        "live_reason_fixtures_test.go",
        "versions_test.go",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "recorded_test_srcs",
    srcs = [
        "golden_test.go",
        "recorded_scenarios_test.go",
    ],
    visibility = ["//visibility:public"],
)

# Argo CD's health testdata (testdata/argo-cd/UPSTREAM), the recorded kind
# scenarios (testdata/kind), the reviewed verdicts, and go.mod for the
# pinned-version check.
filegroup(
    name = "fixture_testdata",
    srcs = ["go.mod"] + glob(["testdata/**"]),
    visibility = ["//visibility:public"],
)
