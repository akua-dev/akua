"""Cluster agent and updater sources, their Helm chart and the Akua package around it.

Sources only, like every package of this module: the binary, image, tests
and type check live in the parent repository's //tools/cluster-agent,
because the agent still imports the platform wire contract from private
workspace packages (@platform/api-contract, @platform/ids,
@platform/kubernetes-schemas). The links below give those tests a
package-local node_modules; they are `manual` so a standalone build of this
module never analyzes them.
"""

load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_js//npm/private:npm_link_package_store.bzl", "npm_link_package_store")

exports_files(
    [
        "package.json",
        "tsconfig.json",
    ],
    visibility = ["//visibility:public"],
)

js_library(
    name = "runtime_srcs",
    srcs = ["package.json"] + glob(
        ["src/**/*.ts"],
        exclude = [
            "src/**/*.test.ts",
            "src/testing/**",
        ],
    ),
    visibility = ["//visibility:public"],
)

# No tsconfig.json: vitest would follow its `extends` into the parent
# repository's shared config, which the type check alone needs.
js_library(
    name = "test_srcs",
    srcs = ["package.json"] + glob(["src/**/*.ts"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "deploy_srcs",
    srcs = glob(["deploy/**"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "typescript_only_policy_srcs",
    srcs = glob(["src/**/*.ts"]),
    visibility = ["//visibility:public"],
)

[
    npm_link_package_store(
        name = "node_modules/" + package,
        src = "//:.aspect_rules_js/node_modules/" + package,
        tags = ["manual"],
        visibility = ["//visibility:public"],
    )
    for package in [
        "@platform/api-contract",
        "@platform/ids",
        "@platform/kubernetes-schemas",
    ]
]
