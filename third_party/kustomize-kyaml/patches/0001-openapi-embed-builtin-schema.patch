From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH 1/1] openapi: embed the built-in schema across the package boundary

Applies to the BUILD files gazelle v0.47.0 generates for
sigs.k8s.io/kustomize/kyaml v0.21.2 (go_repository applies patches after
generating them). openapi/builtin_schema.go embeds
kubernetesapi/data/*.json.gz and kustomizationapi/swagger.json, but
gazelle makes openapi/kubernetesapi and openapi/kustomizationapi
packages of their own and drops the embeds, so compiling openapi fails with
"could not embed ... no matching files found". kyaml is linked into
akua-apply through fluxcd/cli-utils.
---
diff --git a/openapi/BUILD.bazel b/openapi/BUILD.bazel
index d1407fc..9f03e80 100644
--- a/openapi/BUILD.bazel
+++ b/openapi/BUILD.bazel
@@ -6,6 +6,10 @@ go_library(
         "builtin_schema.go",
         "openapi.go",
     ],
+    embedsrcs = [
+        "//openapi/kubernetesapi:data/kubernetes-openapi-union-v1.21.2.bundle-v1.json.gz",
+        "//openapi/kustomizationapi:swagger.json",
+    ],
     importpath = "sigs.k8s.io/kustomize/kyaml/openapi",
     visibility = ["//visibility:public"],
     deps = [
diff --git a/openapi/kubernetesapi/BUILD.bazel b/openapi/kubernetesapi/BUILD.bazel
index 0bb5acc..745bb94 100644
--- a/openapi/kubernetesapi/BUILD.bazel
+++ b/openapi/kubernetesapi/BUILD.bazel
@@ -1,5 +1,7 @@
 load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
 
+exports_files(["data/kubernetes-openapi-union-v1.21.2.bundle-v1.json.gz"])
+
 go_library(
     name = "kubernetesapi",
     srcs = ["openapiinfo.go"],
diff --git a/openapi/kustomizationapi/BUILD.bazel b/openapi/kustomizationapi/BUILD.bazel
index 5441b40..612ffcf 100644
--- a/openapi/kustomizationapi/BUILD.bazel
+++ b/openapi/kustomizationapi/BUILD.bazel
@@ -1,5 +1,7 @@
 load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
 
+exports_files(["swagger.json"])
+
 go_library(
     name = "kustomizationapi",
     srcs = ["swagger.go"],
