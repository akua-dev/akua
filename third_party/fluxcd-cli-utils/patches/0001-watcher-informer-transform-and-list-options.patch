From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH 1/1] watcher: transform, narrow and share the informer cache

Upstream: github.com/fluxcd/cli-utils v1.4.0
(a5cb8826d04810255773aa65bb9b64954188f3f6), pkg/kstatus/watcher.
Applied by go_deps.module_override (MODULE.bazel of the akua module and
of the monorepo root).

Problem. DefaultStatusWatcher.Watch builds its informers with a
hardcoded NewDynamicInformerFactory (default_status_watcher.go:99);
ObjectStatusReporter.InformerFactory is the concrete
*DynamicInformerFactory; the AllowListObjectFilter runs after objects are
already in the informer cache (object_status_reporter.go:486). Every
object of every watched kind and namespace is therefore cached in full,
including metadata.managedFields and the values of Secret and ConfigMap
members.

Change.
1. DynamicInformerFactory gains `Transform cache.TransformFunc` and
   `TweakListOptions func(*metav1.ListOptions)`. NewInformer passes
   TweakListOptions to the list and watch calls and sets Transform on
   the informer before it starts.
2. A new `InformerFactory` interface (NewInformer) replaces the concrete
   type in ObjectStatusReporter.InformerFactory. DefaultStatusWatcher
   gains an optional InformerFactory and the Transform and
   TweakListOptions it copies into the factory Watch builds otherwise.
   akua-apply passes a factory that hands out views of its one shared
   cache, so ssa waits, generated-children reads and live status never
   list the same objects twice.

The engine's Transform removes metadata.managedFields, the
kubectl.kubernetes.io/last-applied-configuration annotation, Secret
.data and .stringData, and ConfigMap .data and .binaryData; kstatus
reads none of them. Its TweakListOptions sets the label selector
`applyset.kubernetes.io/part-of=<applyset id>` when a Placement does not
own its namespace.

Follow-up: propose (1) and (2) upstream to fluxcd/cli-utils; drop this
patch once a release contains them.
---
diff --git a/pkg/kstatus/watcher/default_status_watcher.go b/pkg/kstatus/watcher/default_status_watcher.go
index f3717a9..0f2c1f0 100644
--- a/pkg/kstatus/watcher/default_status_watcher.go
+++ b/pkg/kstatus/watcher/default_status_watcher.go
@@ -14,8 +14,10 @@ import (
 	"github.com/fluxcd/cli-utils/pkg/kstatus/polling/statusreaders"
 	"github.com/fluxcd/cli-utils/pkg/object"
 	"k8s.io/apimachinery/pkg/api/meta"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
 	"k8s.io/apimachinery/pkg/runtime/schema"
 	"k8s.io/client-go/dynamic"
+	"k8s.io/client-go/tools/cache"
 	"k8s.io/klog/v2"
 )
 
@@ -51,6 +53,18 @@ type DefaultStatusWatcher struct {
 	// Defaults to 0 (synchronous, same as original behavior).
 	// Set to a higher value (e.g., 8) to enable concurrent status computation.
 	StatusComputeWorkers int
+
+	// InformerFactory, when set, builds the informers instead of a
+	// DynamicInformerFactory, so callers can share one informer cache
+	// between the watcher and other readers. Transform and
+	// TweakListOptions are then the factory's concern.
+	InformerFactory InformerFactory
+
+	// Transform is passed to the DynamicInformerFactory built by Watch.
+	Transform cache.TransformFunc
+
+	// TweakListOptions is passed to the DynamicInformerFactory built by Watch.
+	TweakListOptions func(*metav1.ListOptions)
 }
 
 var _ StatusWatcher = &DefaultStatusWatcher{}
@@ -95,8 +109,16 @@ func (w *DefaultStatusWatcher) Watch(ctx context.Context, ids object.ObjMetadata
 		return handleFatalError(fmt.Errorf("invalid RESTScopeStrategy: %v", strategy))
 	}
 
+	factory := w.InformerFactory
+	if factory == nil {
+		dynamicFactory := NewDynamicInformerFactory(w.DynamicClient, w.ResyncPeriod)
+		dynamicFactory.Transform = w.Transform
+		dynamicFactory.TweakListOptions = w.TweakListOptions
+		factory = dynamicFactory
+	}
+
 	informer := &ObjectStatusReporter{
-		InformerFactory:      NewDynamicInformerFactory(w.DynamicClient, w.ResyncPeriod),
+		InformerFactory:      factory,
 		Mapper:               w.Mapper,
 		StatusReader:         w.StatusReader,
 		ClusterReader:        w.ClusterReader,
diff --git a/pkg/kstatus/watcher/dynamic_informer_factory.go b/pkg/kstatus/watcher/dynamic_informer_factory.go
index f053e1b..d9cb43b 100644
--- a/pkg/kstatus/watcher/dynamic_informer_factory.go
+++ b/pkg/kstatus/watcher/dynamic_informer_factory.go
@@ -16,10 +16,30 @@ import (
 	"k8s.io/client-go/tools/cache"
 )
 
+// InformerFactory builds the informer for one resource in one namespace
+// (all namespaces when namespace is empty). ObjectStatusReporter calls
+// SetWatchErrorHandler, AddEventHandler and Run on what it returns, so an
+// implementation may hand out views of informers it shares with other
+// readers.
+type InformerFactory interface {
+	NewInformer(ctx context.Context, mapping *meta.RESTMapping, namespace string) cache.SharedIndexInformer
+}
+
+var _ InformerFactory = &DynamicInformerFactory{}
+
 type DynamicInformerFactory struct {
 	Client       dynamic.Interface
 	ResyncPeriod time.Duration
 	Indexers     cache.Indexers
+
+	// Transform, when set, is applied to every object before it enters the
+	// informer cache, for example to drop fields status computation does
+	// not read.
+	Transform cache.TransformFunc
+
+	// TweakListOptions, when set, adjusts the options of every list and
+	// watch call, for example to add a label selector.
+	TweakListOptions func(*metav1.ListOptions)
 }
 
 func NewDynamicInformerFactory(client dynamic.Interface, resyncPeriod time.Duration) *DynamicInformerFactory {
@@ -39,11 +59,17 @@ func (f *DynamicInformerFactory) NewInformer(ctx context.Context, mapping *meta.
 
 	lw := &cache.ListWatch{
 		ListWithContextFunc: func(ctx context.Context, options metav1.ListOptions) (runtime.Object, error) {
+			if f.TweakListOptions != nil {
+				f.TweakListOptions(&options)
+			}
 			return f.Client.Resource(mapping.Resource).
 				Namespace(namespace).
 				List(ctx, options)
 		},
 		WatchFuncWithContext: func(ctx context.Context, options metav1.ListOptions) (watch.Interface, error) {
+			if f.TweakListOptions != nil {
+				f.TweakListOptions(&options)
+			}
 			return f.Client.Resource(mapping.Resource).
 				Namespace(namespace).
 				Watch(ctx, options)
@@ -55,10 +81,15 @@ func (f *DynamicInformerFactory) NewInformer(ctx context.Context, mapping *meta.
 	// fake clients used in tests, which do not support WatchList.
 	wrappedLW := cache.ToListWatcherWithWatchListSemantics(lw, f.Client)
 
-	return cache.NewSharedIndexInformer(
+	informer := cache.NewSharedIndexInformer(
 		wrappedLW,
 		example,
 		f.ResyncPeriod,
 		f.Indexers,
 	)
+	if f.Transform != nil {
+		// Cannot fail: the informer has not been started yet.
+		_ = informer.SetTransform(f.Transform)
+	}
+	return informer
 }
diff --git a/pkg/kstatus/watcher/dynamic_informer_factory_test.go b/pkg/kstatus/watcher/dynamic_informer_factory_test.go
index e7cf862..f457fdc 100644
--- a/pkg/kstatus/watcher/dynamic_informer_factory_test.go
+++ b/pkg/kstatus/watcher/dynamic_informer_factory_test.go
@@ -14,6 +14,7 @@ import (
 	"github.com/stretchr/testify/require"
 	apierrors "k8s.io/apimachinery/pkg/api/errors"
 	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
 	"k8s.io/apimachinery/pkg/apis/testapigroup"
 	"k8s.io/apimachinery/pkg/runtime"
 	"k8s.io/apimachinery/pkg/runtime/schema"
@@ -230,3 +231,57 @@ func newGenericServerResponse(action clienttesting.Action, statusError *apierror
 	// https://github.com/kubernetes/apimachinery/blob/v0.24.0/pkg/api/errors/errors.go#L435
 	return apierrors.NewGenericServerResponse(errorCode, verb, qualifiedResource, name, statusError.Error(), -1, false)
 }
+
+func TestTransformAndTweakListOptions(t *testing.T) {
+	carpGVK := schema.GroupVersionKind{Group: "foo", Version: "v1", Kind: "Carp"}
+	namespace := "example-ns"
+
+	scheme := runtime.NewScheme()
+	scheme.AddKnownTypes(metav1.SchemeGroupVersion, &metav1.Status{})
+
+	carp := &unstructured.Unstructured{}
+	carp.SetGroupVersionKind(carpGVK)
+	carp.SetNamespace(namespace)
+	carp.SetName("member")
+	carp.SetLabels(map[string]string{"part-of": "set"})
+	carp.SetManagedFields([]metav1.ManagedFieldsEntry{{Manager: "kubectl"}})
+	fakeClient := dynamicfake.NewSimpleDynamicClientWithCustomListKinds(scheme,
+		map[schema.GroupVersionResource]string{{Group: "foo", Version: "v1", Resource: "carps"}: "CarpList"},
+		carp)
+
+	var listSelectors, watchSelectors []string
+	fakeClient.PrependReactor("list", "carps", func(a clienttesting.Action) (bool, runtime.Object, error) {
+		listSelectors = append(listSelectors, a.(clienttesting.ListAction).GetListRestrictions().Labels.String())
+		return false, nil, nil
+	})
+	fakeClient.PrependWatchReactor("carps", func(a clienttesting.Action) (bool, watch.Interface, error) {
+		watchSelectors = append(watchSelectors, a.(clienttesting.WatchAction).GetWatchRestrictions().Labels.String())
+		return false, nil, nil
+	})
+
+	informerFactory := NewDynamicInformerFactory(fakeClient, 0)
+	informerFactory.TweakListOptions = func(o *metav1.ListOptions) { o.LabelSelector = "part-of=set" }
+	informerFactory.Transform = func(obj interface{}) (interface{}, error) {
+		if u, ok := obj.(*unstructured.Unstructured); ok {
+			u.SetManagedFields(nil)
+		}
+		return obj, nil
+	}
+
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	mapping, err := testutil.NewFakeRESTMapper(carpGVK).RESTMapping(carpGVK.GroupKind())
+	require.NoError(t, err)
+
+	informer := informerFactory.NewInformer(ctx, mapping, namespace)
+	go informer.Run(ctx.Done())
+	require.True(t, cache.WaitForCacheSync(ctx.Done(), informer.HasSynced))
+	require.Eventually(t, func() bool { return len(watchSelectors) > 0 }, 5*time.Second, 10*time.Millisecond)
+
+	assert.Equal(t, []string{"part-of=set"}, listSelectors)
+	assert.Equal(t, "part-of=set", watchSelectors[0])
+	cached, exists, err := informer.GetStore().GetByKey(namespace + "/member")
+	require.NoError(t, err)
+	require.True(t, exists)
+	assert.Empty(t, cached.(*unstructured.Unstructured).GetManagedFields())
+}
