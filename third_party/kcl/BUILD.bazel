load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load(":vendor.bzl", "package_kcl_vendor")

exports_files([
    "BUILD.bazel",
    ".upstream-rev",
    ".upstream-sha256",
    "upstream.BUILD.bazel",
] + glob([
    "patches/*.patch",
    "*.bzl",
]))

package_kcl_vendor(name = "kcl")

write_source_files(
    name = "write_vendor",
    diff_test = False,
    files = {
        "vendor/kcl-language-server": ":kcl_language_server_vendor",
        "vendor/kcl-parser": ":kcl_parser_vendor",
        "vendor/kcl-runtime": ":kcl_runtime_vendor",
    },
)

filegroup(
    name = "typescript_only_policy_srcs",
    srcs = glob(
        ["**/*.py"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
