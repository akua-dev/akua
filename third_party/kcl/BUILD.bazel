load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("//tools/bazel:buildifier.bzl", "bazel_format_test")

exports_files(glob(["patches/*.patch"]))

filegroup(
    name = "typescript_only_policy_srcs",
    srcs = glob(
        ["**/*.py"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

# The three patched crates, pulled from the pinned+patched kcl-lang/kcl
# archive (see MODULE.bazel) and rerooted so each crate's own directory
# content lands at the directory root - matching the layout Cargo's
# `[patch]` path entries in ../../Cargo.toml expect.
copy_to_directory(
    name = "kcl_parser_vendor",
    srcs = ["@kcl_lang_kcl_931e6a98//:kcl_parser_srcs"],
    include_external_repositories = ["*"],
    include_srcs_patterns = ["crates/parser/**"],
    replace_prefixes = {"crates/parser/": ""},
    visibility = ["//visibility:public"],
)

copy_to_directory(
    name = "kcl_language_server_vendor",
    srcs = ["@kcl_lang_kcl_931e6a98//:kcl_language_server_srcs"],
    include_external_repositories = ["*"],
    include_srcs_patterns = ["crates/tools/src/LSP/**"],
    replace_prefixes = {"crates/tools/src/LSP/": ""},
    visibility = ["//visibility:public"],
)

copy_to_directory(
    name = "kcl_runtime_vendor",
    srcs = ["@kcl_lang_kcl_931e6a98//:kcl_runtime_srcs"],
    include_external_repositories = ["*"],
    include_srcs_patterns = ["crates/runtime/**"],
    replace_prefixes = {"crates/runtime/": ""},
    visibility = ["//visibility:public"],
)

# Registered as a "build" CI gate (root BUILD.bazel core_verification_roots,
# id kcl_vendor_pin): building this forces Bazel to fetch the pinned
# archive, verify its sha256, and apply all five patches, so a broken pin
# (drifted hash, a patch that no longer applies) fails //:ci_build loudly
# instead of only surfacing the next time someone happens to run
# `bazel run //tools/akuapkg:write_kcl_vendor` locally.
filegroup(
    name = "kcl_vendor_pin_check",
    srcs = [
        ":kcl_language_server_vendor",
        ":kcl_parser_vendor",
        ":kcl_runtime_vendor",
    ],
    visibility = ["//visibility:public"],
)

bazel_format_test()
