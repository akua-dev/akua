index 7165816c..0d80c7ce 100644
--- a/crates/parser/Cargo.toml
+++ b/crates/parser/Cargo.toml
@@ -1,15 +1,17 @@
+[workspace]
+
 [package]
 name = "kcl-parser"
-version.workspace = true
-edition.workspace = true
+version = "0.13.0"
+edition = "2024"
 
 # See more keys and their definitions at https://doc.rust-lang.org/cargo/reference/manifest.html
 
 [dependencies]
-compiler_base_span.workspace = true
-compiler_base_session.workspace = true
-compiler_base_error.workspace = true
-compiler_base_macros.workspace = true
+compiler_base_span = { git = "https://github.com/kcl-lang/kcl" }
+compiler_base_session = { git = "https://github.com/kcl-lang/kcl" }
+compiler_base_error = { git = "https://github.com/kcl-lang/kcl" }
+compiler_base_macros = { git = "https://github.com/kcl-lang/kcl" }
 tracing = "0.1"
 serde = { version = "1", features = ["derive"] }
 serde_json = "1.0"
@@ -25,14 +27,14 @@ anyhow = "1.0"
 parking_lot = "0.12.3"
 glob = "0.3.1"
 
-kcl-lexer.workspace = true
-kcl-ast.workspace = true
-kcl-span.workspace = true
-kcl-error.workspace = true
-kcl-config.workspace = true
-kcl-sema.workspace = true
-kcl-utils.workspace = true
-kcl-primitives.workspace = true
+kcl-lexer = { git = "https://github.com/kcl-lang/kcl" }
+kcl-ast = { git = "https://github.com/kcl-lang/kcl" }
+kcl-span = { git = "https://github.com/kcl-lang/kcl" }
+kcl-error = { git = "https://github.com/kcl-lang/kcl" }
+kcl-config = { git = "https://github.com/kcl-lang/kcl" }
+kcl-sema = { git = "https://github.com/kcl-lang/kcl" }
+kcl-utils = { git = "https://github.com/kcl-lang/kcl" }
+kcl-primitives = { git = "https://github.com/kcl-lang/kcl" }
 walkdir = "2"
 
 [dev-dependencies]
