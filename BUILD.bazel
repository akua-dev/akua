"""Source inputs of the standalone package tool."""

filegroup(
    name = "kustomize_example",
    srcs = glob([
        "examples/09-kustomize-hello/**/*.k",
        "examples/09-kustomize-hello/**/*.toml",
        "examples/09-kustomize-hello/**/*.yaml",
    ]),
    visibility = ["//visibility:public"],
)

exports_files([
    ".gitleaksignore",
    "Cargo.toml",
    "Cargo.lock",
])

filegroup(
    name = "rust_sources",
    srcs = [
        "Cargo.lock",
        "Cargo.toml",
        "//tools/akuapkg/source/crates/akua-core:rust_sources",
        "//tools/akuapkg/source/crates/akua-napi:rust_sources",
        "//tools/akuapkg/source/crates/akua-render-worker:rust_sources",
        "//tools/akuapkg/source/crates/akuapkg-cli:rust_sources",
        "//tools/akuapkg/source/crates/engine-host-wasm:rust_sources",
        "//tools/akuapkg/source/crates/helm-engine-wasm:rust_sources",
        "//tools/akuapkg/source/crates/kustomize-engine-wasm:rust_sources",
        "//tools/akuapkg/source/crates/source-hash:rust_sources",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "typescript_only_policy_srcs",
    srcs = [],
    visibility = ["//visibility:public"],
)

exports_files([
    "packages/sdk/tsconfig.json",
    "packages/sdk/src/mod.ts",
    "packages/sdk/src/execute.ts",
])

filegroup(
    name = "sdk_sources",
    srcs = glob(
        [
            "packages/sdk/src/**/*.ts",
            "packages/sdk/src/**/*.json",
        ],
        exclude = ["packages/sdk/src/**/*.test.ts"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "sdk_package_inputs",
    srcs = [
        "packages/sdk/README.md",
        "packages/sdk/package.json",
    ] + glob(
        ["packages/sdk/src/**"],
        exclude = ["packages/sdk/src/**/*.test.ts"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "native_package_inputs",
    srcs = ["//tools/akuapkg/source/crates/akua-napi:native_package_inputs"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "engines_package_inputs",
    srcs = [
        "crates/akua-native-engines-npm/index.js",
        "crates/akua-native-engines-npm/package.json",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "sdk_committed_dist_sources",
    srcs = glob(["packages/sdk/dist/**"]),
    visibility = ["//visibility:public"],
)
