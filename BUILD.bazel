"""Source inputs of the standalone package tool."""

filegroup(
    name = "kustomize_example",
    srcs = glob([
        "examples/09-kustomize-hello/**/*.k",
        "examples/09-kustomize-hello/**/*.toml",
        "examples/09-kustomize-hello/**/*.yaml",
    ]),
    visibility = ["//visibility:public"],
)

# Examples whose committed `rendered/` output the akuapkg binary must
# reproduce byte for byte: local and vendored dependencies only, no network.
filegroup(
    name = "golden_examples",
    srcs = glob([
        "examples/00-helm-hello/**",
        "examples/01-hello-webapp/**",
        "examples/08-pkg-compose/**",
        "examples/09-kustomize-hello/**",
        "examples/11-install-as-package/**",
        "examples/12-vendor-offline/**",
        "examples/13-subpackage-helm/**",
        "examples/15-yaml-output/**",
    ]),
    visibility = ["//visibility:public"],
)

exports_files([
    "BUILD.bazel",
    "MODULE.bazel",
    ".gitleaksignore",
    "Cargo.toml",
    "Cargo.lock",
])

filegroup(
    name = "typescript_only_policy_srcs",
    srcs = [],
    visibility = ["//visibility:public"],
)

# cli.akua.dev: forwarding pages to docs.akua.dev, generated by
# //:write_akua_reference_docs and published by .github/workflows/pages.yml.
filegroup(
    name = "pages",
    srcs = glob(["pages/**"]),
    visibility = ["//:__pkg__"],
)
