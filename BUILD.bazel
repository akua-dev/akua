"""Source inputs of the standalone package tool."""

filegroup(
    name = "kustomize_example",
    srcs = glob([
        "examples/09-kustomize-hello/**/*.k",
        "examples/09-kustomize-hello/**/*.toml",
        "examples/09-kustomize-hello/**/*.yaml",
    ]),
    visibility = ["//visibility:public"],
)

exports_files([
    ".gitleaksignore",
    "Cargo.toml",
    "Cargo.lock",
])

filegroup(
    name = "typescript_only_policy_srcs",
    srcs = [],
    visibility = ["//visibility:public"],
)

exports_files([
    "packages/sdk/tsconfig.json",
    "packages/sdk/src/mod.ts",
    "packages/sdk/src/execute.ts",
])

filegroup(
    name = "sdk_sources",
    srcs = glob(
        [
            "packages/sdk/src/**/*.ts",
            "packages/sdk/src/**/*.json",
        ],
        exclude = ["packages/sdk/src/**/*.test.ts"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "sdk_package_inputs",
    srcs = [
        "packages/sdk/README.md",
        "packages/sdk/package.json",
    ] + glob(
        ["packages/sdk/src/**"],
        exclude = ["packages/sdk/src/**/*.test.ts"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "engines_package_inputs",
    srcs = [
        "crates/akua-native-engines-npm/index.js",
        "crates/akua-native-engines-npm/package.json",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "sdk_committed_dist_sources",
    srcs = glob(["packages/sdk/dist/**"]),
    visibility = ["//visibility:public"],
)
