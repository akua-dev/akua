"""Root-level sources. Build targets live in //bazel; see docs/building.md.

Keep this file and the other source packages (host, native, cli, crates,
third_party) to source groups and local labels: the cnap monorepo also loads
them as ordinary packages of its own workspace.
"""

exports_files(
    [
        ".gitleaksignore",
        "BUILD.bazel",
        "Cargo.lock",
        "Cargo.toml",
        "MODULE.bazel",
        "bun.lock",
        "package.json",
        "patches/effect@4.0.1.patch",
        "toolchains.MODULE.bazel",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "cli_workflow",
    srcs = [".github/workflows/cli.yml"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "kustomize_example",
    srcs = glob([
        "examples/09-kustomize-hello/**/*.k",
        "examples/09-kustomize-hello/**/*.toml",
        "examples/09-kustomize-hello/**/*.yaml",
    ]),
    visibility = ["//visibility:public"],
)

# Examples whose committed `rendered/` output the akuapkg binary must
# reproduce byte for byte: local and vendored dependencies only, no network.
filegroup(
    name = "golden_examples",
    srcs = glob([
        "examples/00-helm-hello/**",
        "examples/01-hello-webapp/**",
        "examples/08-pkg-compose/**",
        "examples/09-kustomize-hello/**",
        "examples/10-kcl-ecosystem/**",
        "examples/11-install-as-package/**",
        "examples/12-vendor-offline/**",
        "examples/13-subpackage-helm/**",
        "examples/15-yaml-output/**",
        "examples/16-typed-crds/**",
    ]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "typescript_only_policy_srcs",
    srcs = [],
    visibility = ["//visibility:public"],
)

# cli.akua.dev: forwarding pages to docs.akua.dev, generated from the error
# catalog and published by .github/workflows/pages.yml.
filegroup(
    name = "pages",
    srcs = glob(["pages/**"]),
    visibility = ["//visibility:public"],
)
