"""Declared source inputs for the package core crate."""

exports_files([
    "BUILD.bazel",
    "src/lib.rs",
    "Cargo.toml",
])

# Build scripts and declarations are optional across the pinned crate inputs.
# buildifier: disable=constant-glob
filegroup(
    name = "rust_sources",
    srcs = ["Cargo.toml"] + glob(
        [
            "src/**",
            "stdlib/**",
            "build.rs",
            "index.d.ts",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "compiler_sources",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "compiler_data",
    srcs = ["tests/fixtures/helm-multidoc.yaml"] + glob(["stdlib/**/*.k"]),
    visibility = ["//visibility:public"],
)
