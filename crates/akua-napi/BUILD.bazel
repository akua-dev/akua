"""Official Linux NAPI addon from the pinned package Cargo closure."""

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
    "build.rs",
])

# Build scripts and declarations are optional across the pinned crate inputs.
# buildifier: disable=constant-glob
filegroup(
    name = "rust_sources",
    srcs = ["Cargo.toml"] + glob(
        [
            "src/**",
            "build.rs",
            "index.d.ts",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "native_package_inputs",
    srcs = [
        "index.d.ts",
        "index.js",
        "loader.js",
        "package.json",
    ],
    visibility = ["//visibility:public"],
)

exports_files([
    "src/lib.rs",
])

filegroup(
    name = "rust_compile_sources",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
)
