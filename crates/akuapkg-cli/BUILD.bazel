"""Source inputs for the package command-line executable."""

exports_files(["Cargo.toml"])

filegroup(
    name = "rust_sources",
    srcs = ["Cargo.toml"] + glob(
        [
            "src/**",
            "build.rs",
            "index.d.ts",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

exports_files([
    "src/lib.rs",
    "src/main.rs",
    "build.rs",
])

filegroup(
    name = "rust_library_sources",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    visibility = ["//visibility:public"],
)
