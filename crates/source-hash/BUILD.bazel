"""The source digest utility from the pinned package workspace."""

load("@platform_package_napi_crates//:defs.bzl", napi_deps = "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")

exports_files(["Cargo.toml"])

filegroup(
    name = "rust_sources",
    srcs = ["Cargo.toml"] + glob(
        [
            "src/**",
            "build.rs",
            "index.d.ts",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

rust_library(
    name = "source_hash_napi",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "source_hash",
    crate_root = "src/lib.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = napi_deps(
        package_name = "tools/akuapkg/source/crates/source-hash",
        normal = True,
    ),
)

rust_binary(
    name = "source_hash_bin",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [":source_hash_napi"],
)
