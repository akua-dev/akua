"""The source digest utility from the pinned package workspace."""

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
])

# Build scripts and declarations are optional across the pinned crate inputs.
# buildifier: disable=constant-glob
filegroup(
    name = "rust_sources",
    srcs = ["Cargo.toml"] + glob(
        [
            "src/**",
            "build.rs",
            "index.d.ts",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

exports_files([
    "src/lib.rs",
    "src/main.rs",
])

filegroup(
    name = "rust_library_sources",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    visibility = ["//visibility:public"],
)
