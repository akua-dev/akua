"""The sandboxed render worker for the package runtime."""

exports_files(["Cargo.toml"])

filegroup(
    name = "rust_sources",
    srcs = ["Cargo.toml"] + glob(
        [
            "src/**",
            "build.rs",
            "index.d.ts",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

exports_files(["src/main.rs"])

filegroup(
    name = "rust_compile_sources",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
)
