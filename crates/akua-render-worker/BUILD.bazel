"""The sandboxed render worker for the package runtime."""

load("@platform_package_crates//:defs.bzl", "aliases", "crate_deps")
load("@platform_package_source_version//:version.bzl", "PACKAGE_SOURCE_VERSION")
load("@rules_rust//rust:defs.bzl", "rust_binary")

exports_files(["Cargo.toml"])

filegroup(
    name = "rust_sources",
    srcs = ["Cargo.toml"] + glob(
        [
            "src/**",
            "build.rs",
            "index.d.ts",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "render_worker",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(
        package_name = "tools/akuapkg/source/crates/akua-render-worker",
        normal = True,
    ),
    crate_name = "akua_render_worker",
    crate_root = "src/main.rs",
    edition = "2021",
    rustc_env = {
        "CARGO_PKG_NAME": "akua-render-worker",
        "CARGO_PKG_VERSION": PACKAGE_SOURCE_VERSION,
    },
    visibility = ["//visibility:public"],
    deps = ["//tools/akuapkg/source/crates/akua-core:core_worker"] + crate_deps(
        [
            "serde",
            "serde_json",
            "serde_yaml",
            "tracing",
            "tracing-subscriber",
        ],
        package_name = "tools/akuapkg/source/crates/akua-render-worker",
    ),
)
