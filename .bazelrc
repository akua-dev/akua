# C dependencies build with the pinned Zig and clang-cl toolchains, never a
# compiler found on the host.
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
build --@rules_rust//cargo/settings:incompatible_runfiles_cargo_manifest_dir=false

# `--stamp` records the checkout's commit in the release metadata.
build --workspace_status_command="git log -1 --format='STABLE_SOURCE_SHA %H' 2>/dev/null || true"

# Every release target cross-compiles on Linux x86_64 (docs/building.md). On
# another host, run the actions on a Linux x86_64 remote executor:
#   bazel build --config=remote --remote_executor=grpcs://<your REAPI endpoint> //bazel:akuapkg_darwin_arm64
build:remote --extra_execution_platforms=//bazel/platforms:linux_x64_exec
build:remote --platforms=//bazel/platforms:target_linux_x64
build:remote --remote_download_toplevel
build:remote --jobs=32

try-import %workspace%/.bazelrc.user
