// Entry point of the `akuapkg` executable for {TARGET}, generated from
// bazel/akuapkg_entry.ts.tmpl. The host itself (packages/akuapkg/) is target-independent;
// akuapkg_embedded_{TARGET}.ts carries the target's assets.
import { BunCrypto, BunRuntime, BunServices } from "@effect/platform-bun"
import { Effect, Layer } from "effect"
import { AKUAPKG_VERSION, embeddedAssets } from "./akuapkg_embedded_{TARGET}.ts"
import { runAkuapkg } from "../packages/akuapkg/src/cli.ts"

runAkuapkg(AKUAPKG_VERSION, embeddedAssets).pipe(
  Effect.provide(Layer.mergeAll(BunServices.layer, BunCrypto.layer)),
  BunRuntime.runMain
)
