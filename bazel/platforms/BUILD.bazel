"""Release target platforms and the settings that select the package Rust toolchain."""

load("@bazel_skylib//rules:common_settings.bzl", "string_flag")

# The release Rust (1.98.1) is selected only inside the package Rust
# transitions, so it never competes with another Rust toolchain a consuming
# repository registers for its own crates.
string_flag(
    name = "package_rust_version",
    build_setting_default = "default",
    visibility = ["//visibility:public"],
)

config_setting(
    name = "package_rust_198",
    flag_values = {":package_rust_version": "1.98.1"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "darwin",
    constraint_values = ["@platforms//os:osx"],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "darwin_x64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:osx",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "darwin_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:osx",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "windows",
    constraint_values = ["@platforms//os:windows"],
    visibility = ["//visibility:public"],
)

platform(
    name = "render_worker_wasi",
    constraint_values = [
        "@platforms//cpu:wasm32",
        "@platforms//os:wasi",
        "@rules_rust//rust/platform:wasi_preview_1",
    ],
    visibility = ["//visibility:public"],
)

# Build-time package Rust tools (the Wasmtime precompiler, the aarch64 link
# shim) run on Linux x86_64 executors.
platform(
    name = "linux_x64_exec",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    visibility = ["//visibility:public"],
)

[
    platform(
        name = name,
        constraint_values = [
            "@platforms//cpu:" + cpu,
            "@platforms//os:" + os,
        ],
        visibility = ["//visibility:public"],
    )
    for name, os, cpu in [
        ("target_darwin_arm64", "osx", "aarch64"),
        ("target_darwin_x64", "osx", "x86_64"),
        ("target_linux_arm64", "linux", "aarch64"),
        ("target_linux_x64", "linux", "x86_64"),
        ("target_windows_x64", "windows", "x86_64"),
    ]
]

filegroup(
    name = "starlark_sources",
    srcs = glob(
        [
            "*.bazel",
            "*.bzl",
        ],
        allow_empty = True,
    ),
    visibility = ["//bazel:__pkg__"],
)
