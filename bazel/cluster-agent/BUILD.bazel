# ClusterAgent.ts liveReasonFixtures.reasonTest: every Argo CD health
# fixture through the engine's node builder, against reviewed verdicts.
go_test(
    name = "live_reason_fixtures_test",
    size = "small",
    srcs = [_SRC + ":fixture_test_srcs"],
    data = [_SRC + ":fixture_testdata"],
    rundir = "packages/cluster-agent/engine",
    deps = [
        ":live",
        ":protocol",
        "@io_k8s_apimachinery//pkg/apis/meta/v1/unstructured",
        "@io_k8s_sigs_yaml//:yaml",
    ],
)

# ClusterAgent contract liveReasonFixtures.recordedTest: the kind
# recordings decode with today's protocol and fold to their reasons.
go_test(
    name = "recorded_scenarios_test",
    size = "small",
    srcs = [_SRC + ":recorded_test_srcs"],
    data = [_SRC + ":fixture_testdata"],
    rundir = "packages/cluster-agent/engine",
    deps = [
        ":live",
        ":protocol",
    ],
)

test_suite(
    name = "engine_tests",
    tests = [
        ":cache_test",
        ":live_reason_fixtures_test",
        ":live_test",
        ":ops_test",
        ":protocol_test",
        ":recorded_scenarios_test",
        ":serve_test",
